# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Кластер из 3 узлов с разным начальным уровнем зрелости DevSecOps.
# Запуск: vagrant up  (из папки vagrant/)
# SSH:    vagrant ssh node-critical

NODES = [
  {
    name:   "node-critical",
    ip:     "192.168.56.10",
    script: "provision/node1_critical.sh",
    desc:   "Уровень CRITICAL — нет сервисов, слабый SSH, нет firewall"
  },
  {
    name:   "node-app",
    ip:     "192.168.56.20",
    script: "provision/node2_app.sh",
    desc:   "Уровень LOW — HTTP только, слабый SSH, firewall неактивен"
  },
  {
    name:   "node-secure",
    ip:     "192.168.56.30",
    script: "provision/node3_secure.sh",
    desc:   "Уровень MEDIUM — HTTPS есть, SSH частично настроен, firewall активен"
  }
].freeze

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false

  # Отключаем синхронизацию папок (не нужна для демо)
  config.vm.synced_folder ".", "/vagrant", disabled: true

  NODES.each do |node|
    config.vm.define node[:name] do |vm_config|
      vm_config.vm.hostname = node[:name]
      vm_config.vm.network "private_network", ip: node[:ip]

      vm_config.vm.provider "virtualbox" do |vb|
        vb.name   = node[:name]
        vb.memory = 512
        vb.cpus   = 1
        vb.gui    = false
        # Ускорение запуска
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end

      vm_config.vm.provision "shell", path: node[:script]

      vm_config.vm.post_up_message = "#{node[:name]} (#{node[:ip]}) готов. #{node[:desc]}"
    end
  end
end
